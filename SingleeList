import java.util.*;

class SingleeList {
    static final int INF = Integer.MAX_VALUE;

    static class Pair {
        int vertex, weight;
        Pair(int vertex, int weight) {
            this.vertex = vertex;
            this.weight = weight;
        }
    }

    static int minDistance(int[] dist, boolean[] sptSet, int n) {
        int min = INF, minIndex = -1;
        for (int v = 0; v < n; v++) {
            if (!sptSet[v] && dist[v] < min) {
                min = dist[v];
                minIndex = v;
            }
        }
        return minIndex;
    }

    static void shortest(List<List<Pair>> cost, int s, int n) {
        int[] dist = new int[n];
        boolean[] sptSet = new boolean[n];
        Arrays.fill(dist, INF);
        dist[s] = 0;

        for (int j = 0; j < n - 1; j++) {
            int u = minDistance(dist, sptSet, n);
            if (u == -1) break;

            sptSet[u] = true;

            for (Pair neighbor : cost.get(u)) {
                int v = neighbor.vertex;
                int w = neighbor.weight;

                if (!sptSet[v] && dist[u] != INF && dist[u] + w < dist[v]) {
                    dist[v] = dist[u] + w;
                }
            }
        }

        System.out.println("Vertex \t Distance from Source");
        for (int i = 0; i < n; i++) {
            System.out.println(i + " \t\t " + (dist[i] == INF ? "INF" : dist[i]));
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter the number of vertices: ");
        int n = sc.nextInt();

        List<List<Pair>> cost = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            cost.add(new ArrayList<>());
        }

        System.out.print("Enter the number of edges: ");
        int e = sc.nextInt();

        System.out.println("Enter each edge as: u v w (from-vertex to-vertex weight)");
        for (int i = 0; i < e; i++) {
            System.out.print("Edge " + (i + 1) + ": ");
            int u = sc.nextInt();
            int v = sc.nextInt();
            int w = sc.nextInt();
            cost.get(u).add(new Pair(v, w));
        }

        System.out.print("Enter the source vertex: ");
        int s = sc.nextInt();

        shortest(cost, s, n);

        sc.close();
    }
}
